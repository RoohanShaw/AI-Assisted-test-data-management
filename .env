# ─────────────────────────────────────────────────────────
# AI Test Data Generator — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────

# Required: Your OpenAI API Key (for unknown field fallback)
#OPENAI_API_KEY=

# Optional: Override which OpenAI model to use
# OPENAI_MODEL=gpt-4o-mini

# Optional: Faker locale (default: en_IN for Indian names/data)
# DEFAULT_LOCALE=en_IN
